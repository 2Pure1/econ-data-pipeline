# ==============================================================================
# 🏗️ Econ Data Pipeline - Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in the required values.
# Do NOT commit your actual .env file to version control.

# ------------------------------------------------------------------------------
# 🔑 API Keys
# ------------------------------------------------------------------------------
# BEA (Bureau of Economic Analysis) - Required for primary GDP, PCE data
# Sign up: https://apps.bea.gov/api/signup/
BEA_API_KEY=

# FRED (Federal Reserve Economic Data) - Required for secondary macro data
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BLS (Bureau of Labor Statistics) - Recommended (removes strict rate limits)
# Sign up: https://www.bls.gov/developers/api_signature_v2.htm
BLS_API_KEY=

# Note: World Bank and Yahoo Finance do not require API keys.

# ------------------------------------------------------------------------------
# 🐘 PostgreSQL Database (Local Development)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# ☁️ Cloud Infrastructure - AWS
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_RAW_BUCKET=
S3_PROCESSED_BUCKET=

# ------------------------------------------------------------------------------
# ☁️ Cloud Infrastructure - GCP (BigQuery)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# ⚙️ Orchestration (Airflow / Mage / Kestra)
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
